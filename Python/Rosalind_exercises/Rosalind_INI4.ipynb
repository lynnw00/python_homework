    "b = 9763\n",
    "result = 0\n",
    "# Including last position, add +1, otherwise we will miss the last one.\n",
    "for n in range (a, b+1):\n",
    "    if n % 2 == 1: #is it odd?\n",
    "        result = result + n\n",
    "print(result)    "
